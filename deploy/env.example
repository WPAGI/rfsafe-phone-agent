# Names only. Put values in the host's secret settings, never in a file in this package.
# Leave PA_MODE as demo until GO-LIVE.md says to switch.
PA_MODE=demo
PORT=8787
PUBLIC_BASE_URL=            # https://rfsafe-phone-agent.onrender.com  (no trailing slash)
DATA_DIR=/var/data
TENANTS_DIR=/var/data/tenants
PA_ADMIN_TOKEN=             # openssl rand -base64 32
PA_STATE_SECRET=            # openssl rand -base64 32
PA_MASTER_KEY=              # openssl rand -base64 32  (exactly 32 bytes; encrypts tenant tokens)
XAI_API_KEY=                # xAI console, team with billing (APPROVAL REQUIRED)
XAI_TEXT_MODEL=grok-4.7
TWILIO_ACCOUNT_SID=         # used by scripts/provision-number.js
RFSAFE_PHONE_NUMBER=        # E.164, after the number is bought
RFSAFE_XAI_WEBHOOK_SECRET=  # returned ONCE by POST /v2/phone-numbers
RFSAFE_TWILIO_AUTH_TOKEN=   # Twilio auth token
RFSAFE_SHOPIFY_STOREFRONT_TOKEN=  # optional; public mode needs no token
PA_LOG_FILE=                # optional; default stdout
